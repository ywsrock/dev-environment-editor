" =============================================================================
" options.vim - 基本設定
" =============================================================================

" -----------------------------------------------------------------------------
" エンコーディング
" -----------------------------------------------------------------------------
set encoding=utf-8
" 文字コードの判定順（左から順に試し、最初に読めたものを使う）
"   ucs-bom を先頭: BOM 付きの UTF-16 / UTF-8（SSMS が出力する SQL など）を正しく判定
"   latin1 を最後: どんなファイルでも読めてしまうため、最後の手段にする
"   BOM なしの UTF-16 は判定できないので :e ++enc=utf-16le で開き直す
set fileencodings=ucs-bom,utf-8,cp932,euc-jp,iso-2022-jp,default,latin1
set fileformats=unix,dos,mac

" -----------------------------------------------------------------------------
" 表示
" -----------------------------------------------------------------------------
set number                    " 行番号表示
set cursorline                " カーソル行をハイライト
set showmatch                 " 対応する括弧をハイライト
set showcmd                   " 入力中のコマンドを表示
set showmode                  " 現在のモードを表示
set laststatus=2              " 常にステータスラインを表示
set signcolumn=yes            " サインカラムを常に表示
set ambiwidth=double          " 曖昧な幅の文字を全角として扱う
syntax on

" -----------------------------------------------------------------------------
" 検索
" -----------------------------------------------------------------------------
set hlsearch                  " 検索結果をハイライト
set incsearch                 " インクリメンタルサーチ
set ignorecase                " 大文字小文字を無視
set smartcase                 " 大文字が含まれていたら区別

" -----------------------------------------------------------------------------
" インデント / タブ
" -----------------------------------------------------------------------------
set autoindent                " 自動インデント
set tabstop=2                 " タブ幅
set shiftwidth=2              " インデント幅
set expandtab                 " タブをスペースに変換

" -----------------------------------------------------------------------------
" 編集
" -----------------------------------------------------------------------------
set backspace=2               " バックスペースで何でも消せるように
set clipboard=unnamedplus     " システムクリップボードを使用

" -----------------------------------------------------------------------------
" ウィンドウ / バッファ
" -----------------------------------------------------------------------------
set splitright                " 新しいウィンドウを右に開く
set autochdir                 " カレントディレクトリを自動的に変更

" -----------------------------------------------------------------------------
" 補完
" -----------------------------------------------------------------------------
set wildmenu                  " コマンドライン補完
set wildmode=list,full        " 補完モード

" -----------------------------------------------------------------------------
" 折りたたみ
" -----------------------------------------------------------------------------
" Treesitter ベースの折りたたみ（シンタックスに基づく正確な折りたたみ）
" ショートカット:
"   za    現在位置の折りたたみをトグル
"   zc    現在位置を折りたたむ
"   zo    現在位置を展開
"   zR    全て展開
"   zM    全て折りたたむ
"   zj/zk 次/前の折りたたみへ移動
set foldmethod=expr
set foldexpr=v:lua.vim.treesitter.foldexpr()
set foldnestmax=10            " 最大折りたたみ深度
set nofoldenable              " 起動時は折りたたまない（手動でトグル）
set foldlevel=99              " 起動時は全て展開状態
set foldcolumn=1              " 折りたたみカラムを表示（左端に + / - 表示）

" -----------------------------------------------------------------------------
" バックアップ / スワップ
" -----------------------------------------------------------------------------
set nobackup
set nowritebackup

" -----------------------------------------------------------------------------
" パフォーマンス
" -----------------------------------------------------------------------------
set updatetime=300            " CursorHold までの時間（ms）

" -----------------------------------------------------------------------------
" その他
" -----------------------------------------------------------------------------
set belloff=all               " ベルを無効化

" -----------------------------------------------------------------------------
" スペルチェック（VSCode以外）
" -----------------------------------------------------------------------------
" spelunker.vim が担当するため Vim 標準の spell はオフにする
" （両方オンだと同じ単語に2種類の下線が付く。spelunker 公式の推奨設定）
" spelllang は spelunker が単語の判定に使う（cjk = 日本語などはチェックしない）
set nospell
" spelunker は画面に表示されている部分だけをチェック（カーソルを止めた時）
" （既定はファイルを開いた時・保存した時にファイル全体をチェックし、6MB のファイルで
"   開くのに 30〜50 秒かかったため。変更後は 0.5〜2 秒）
let g:spelunker_check_type = 2
if !exists('g:vscode')
  set spelllang=en_us,cjk
endif

" -----------------------------------------------------------------------------
" True Color サポート
" -----------------------------------------------------------------------------
if has("termguicolors")
  set termguicolors
endif

